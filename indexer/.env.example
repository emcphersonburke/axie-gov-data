# ---- RPC endpoints ---------------------------------------------------------------------------
# Primary JSON-RPC endpoint (no key in the URL; the key goes in the header). The API key is only ever
# sent to *.skymavis.com hosts, so pointing this at the public https://api.roninchain.com/rpc for a
# smoke test is safe — but that endpoint caps eth_getLogs at 200 blocks (learned automatically),
# rejects JSON-RPC batches above 3 (set RPC_BATCH_SIZE=3), rate limits hard below ~5 req/s, and only
# serves receipts/headers for roughly the last 2.5M blocks.
RONIN_RPC_URL=https://api-gateway.skymavis.com/rpc
# Sky Mavis API key (the only real secret) — sent as X-API-KEY on RPC and X-API-Key on GraphQL calls
RONIN_API_KEY=
# HTTP basic auth for the primary endpoint, "user:password" (Chainstack's password-protected endpoint)
# RONIN_RPC_BASIC_AUTH=
# Pin the primary to these methods (comma-separated) and prefer it for them; same as methods= below.
# Unset = the primary serves everything.
# RONIN_RPC_METHODS=
# Routing priority of the primary: lower is tried first (extras default to 10)
# RONIN_RPC_PRIORITY=0
#
# Extra endpoints, comma-separated:   url|rps|batchSize|option=value;option=value
#   rps, batchSize    default to RPC_START_RPS / RPC_BATCH_SIZE; leave empty to keep the default (url|||...)
#   methods=eth_getLogs,eth_getBlockByNumber
#                     the endpoint serves ONLY these methods and is preferred over general endpoints for them
#   priority=N        lower is tried first among the endpoints eligible for a method (default 10; primary 0)
#   basic=user:pw     HTTP basic auth for this endpoint (what RONIN_RPC_BASIC_AUTH is for the primary)
#   key=…             X-API-KEY header for this endpoint (RONIN_API_KEY is never sent to extras)
# Credential values must not contain "|" or ";". Routing: a call goes to the endpoints allowlisted for
# its method first (by priority), then to endpoints without an allowlist (by priority); endpoints of
# equal priority share load. Any non-rate-limit error moves the call to the next endpoint immediately
# and puts the failing one in cooldown (30 s, doubling per consecutive failure up to 10 min, cleared by
# its next success). Rate limits (429) stay on the endpoint that raised them: it slows down and waits.
#
# Chainstack's eth_getLogs is only trustworthy for recent blocks (~1–5M behind head): for older ranges
# it returns an EMPTY list, not an error, so discovery would silently miss everything. Its receipts,
# headers and eth_getBlockReceipts are fine for the whole chain. Alchemy has a correct log index for
# all history but a tight free compute budget. Hence the two real-world layouts:
#
# 1) Backfill — Chainstack (basic auth) serves receipts/headers, Alchemy is pinned to discovery:
# RONIN_RPC_URL=https://ronin-mainnet.core.chainstack.com/<path>
# RONIN_RPC_BASIC_AUTH=<user>:<password>
# RPC_URLS=https://ronin-mainnet.g.alchemy.com/v2/<key>|20|20|methods=eth_getLogs;priority=0
#
# 2) Steady state — Chainstack free as primary, Alchemy a pure backup that takes over on outages:
# RONIN_RPC_URL=https://ronin-mainnet.core.chainstack.com/<path>
# RPC_URLS=https://ronin-mainnet.g.alchemy.com/v2/<key>|20|20|priority=10
#
# Public RPC as a pool member (smoke tests only; see the caps above):
# RPC_URLS=https://api.roninchain.com/rpc|3|3
# ---- storage / logging ------------------------------------------------------------------------
# SQLite database file (created on first run, directory included)
DB_PATH=./data/indexer.db
# Directory the web server serves as /data/ ; dashboard.json + health.json are written here atomically
SNAPSHOT_DIR=./data/snapshots
# pino level: trace|debug|info|warn|error
LOG_LEVEL=info
# Blocks behind head treated as final (reorg + replica-lag guard)
CONFIRMATIONS=30
# ---- development overrides (defaults live in shared/src/contracts.ts and indexer/src/config.ts) ----
# START_BLOCK=16377111
# BRIDGE_START_BLOCK=14765762
# RPC_START_RPS=10          # token bucket start, in HTTP requests per second (one request = one JSON-RPC batch)
# RPC_MAX_RPS=50            # AIMD ceiling; set from `backfill --probe`
# RPC_CONCURRENCY=64        # in-flight sub-calls, so batches fill
# RPC_BATCH_SIZE=20         # sub-calls per HTTP request (viem batching); 3 for the public RPC
# RANGE_START=2000          # eth_getLogs block range to start with; grows x1.5 to RANGE_MAX, halves on limit errors
# RANGE_MAX=100000
# RANGE_MIN=50
# TS_ANCHOR_INTERVAL=64     # blocks between timestamp anchors when interpolating during backfill
# TAIL_SLEEP_MS=15000
# LOG_FETCH_STRATEGY=receipts   # receipts (default) | range
# RATES_URL=https://api-gateway.skymavis.com/graphql/marketplace
# RATES_INTERVAL_MS=300000
# RATES_STALE_MS=1800000
# SNAPSHOT_INTERVAL_MS=300000
# WAL_CHECKPOINT_INTERVAL_MS=600000
