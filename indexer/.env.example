# Sky Mavis JSON-RPC gateway URL for Ronin mainnet (no key in the URL; the key goes in the header)
RONIN_RPC_URL=https://api-gateway.skymavis.com/rpc
# Sky Mavis API key (the only real secret) — sent as X-API-KEY on RPC and GraphQL calls
RONIN_API_KEY=
# Optional extra endpoints for receipt/block load, "url|rps" entries separated by commas
# RPC_URLS=https://api.roninchain.com/rpc|5
# SQLite database file (created on first run)
DB_PATH=./data/indexer.db
# Directory the web server serves as /data/ ; dashboard.json + health.json are written here atomically
SNAPSHOT_DIR=./data/snapshots
# pino level: trace|debug|info|warn|error
LOG_LEVEL=info
# Blocks behind head treated as final (reorg + replica-lag guard)
CONFIRMATIONS=30
# ---- development overrides (defaults live in shared/src/contracts.ts and indexer/src/config.ts) ----
# START_BLOCK=16377111
# BRIDGE_START_BLOCK=14765762
# RPC_START_RPS=10
# RPC_MAX_RPS=50
# RPC_CONCURRENCY=64
# RPC_BATCH_SIZE=20
# RANGE_START=2000
# RANGE_MAX=100000
# TS_ANCHOR_INTERVAL=64
# TAIL_SLEEP_MS=15000
# LOG_FETCH_STRATEGY=receipts
