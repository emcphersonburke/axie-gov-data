{
  "name": "@axie-gov/indexer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "axie-indexer": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx --env-file=.env src/cli.ts tail",
    "start": "node dist/cli.js tail",
    "test": "vitest run",
    "test:integration": "INTEGRATION=1 vitest run test/integration"
  },
  "dependencies": {
    "@axie-gov/shared": "*",
    "better-sqlite3": "^12.2.0",
    "pino": "^9.7.0",
    "viem": "^2.31.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.20.0",
    "vitest": "^3.2.0"
  }
}
