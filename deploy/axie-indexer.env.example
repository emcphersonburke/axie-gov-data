# Installed at /etc/axie-indexer.env (owner root:axie, mode 0640). Referenced by systemd EnvironmentFile=.
RONIN_RPC_URL=https://api-gateway.skymavis.com/rpc
RONIN_API_KEY=REPLACE_ME
# Optional extra endpoints for receipt/block load, "url|rps" entries separated by commas
# RPC_URLS=https://api.roninchain.com/rpc|5
DB_PATH=/var/lib/axie-indexer/indexer.db
SNAPSHOT_DIR=/srv/axie/data
LOG_LEVEL=info
CONFIRMATIONS=30
NODE_OPTIONS=--max-old-space-size=1024
